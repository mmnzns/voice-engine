{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ensayo/classify-question.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "behavioral_situation", "commitment_check", "builder_operator_check", "is_major_story", "competencies"],
  "properties": {
    "type": {"enum": ["behavioral", "tell_me_about_yourself", "technical", "factual", "future_looking", "gap", "motivation"]},
    "behavioral_situation": {"enum": ["problem_solving", "disagreement", "influence", "serving_customers", "leading_team", "motivation", "other", null]},
    "commitment_check": {"type": "boolean"},
    "builder_operator_check": {"type": "boolean"},
    "is_major_story": {"type": "boolean"},
    "competencies": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "maxLength": 40}}
  }
}
