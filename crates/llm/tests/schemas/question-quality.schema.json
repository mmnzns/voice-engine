{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ensayo/question-quality.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["questions", "weakest", "try_asking", "note", "must_say_said"],
  "properties": {
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["q", "asked", "result", "checks", "early_logistics", "quote", "reason"],
        "properties": {
          "q": {"type": "integer", "minimum": 1},
          "asked": {"type": "boolean"},
          "result": {"enum": ["pass", "fail"]},
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["specific", "front_loaded", "not_answered", "one_question"],
            "properties": {
              "specific": {"type": "boolean"},
              "front_loaded": {"type": "boolean"},
              "not_answered": {"type": "boolean"},
              "one_question": {"type": "boolean"}
            }
          },
          "early_logistics": {"type": "boolean"},
          "quote": {"type": "string", "maxLength": 200},
          "reason": {"type": "string", "maxLength": 240}
        }
      }
    },
    "weakest": {"type": "integer", "minimum": 1, "description": "q number of the weakest question, or 1 when none was asked"},
    "try_asking": {"type": "string", "maxLength": 300},
    "note": {"type": "string", "maxLength": 300},
    "must_say_said": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "said", "where", "quote"],
        "properties": {
          "id": {"type": "string"},
          "said": {"type": "boolean"},
          "where": {"type": ["string", "null"], "pattern": "^\\[(A|Q) \\d+\\.\\d+\\]$"},
          "quote": {"type": ["string", "null"], "maxLength": 200}
        }
      }
    }
  }
}
